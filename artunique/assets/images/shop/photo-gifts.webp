<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D5005B"/>
      <stop offset="50%" stop-color="#A80046"/>
      <stop offset="100%" stop-color="#550024"/>
    </linearGradient>
  
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <radialGradient id="sparkle" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFF" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#FFF" stop-opacity="0"/>
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#grad)"/>
  
  <!-- Subtle decorative overlays -->
  <circle cx="680" cy="120" r="240" fill="#00C2CB" opacity="0.15" filter="url(#glow)"/>
  <circle cx="120" cy="480" r="210" fill="#F5A623" opacity="0.12" filter="url(#glow)"/>
  <circle cx="400" cy="300" r="300" fill="#FFFFFF" opacity="0.05"/>
  
  <!-- Star sparkles -->
  <circle cx="200" cy="150" r="48" fill="url(#sparkle)"/>
  <circle cx="600" cy="450" r="36" fill="url(#sparkle)"/>
  <circle cx="720" cy="210" r="30" fill="url(#sparkle)"/>
  
  <!-- Gift Art vector graphics placeholder -->
  <g transform="translate(400, 252) scale(1)">
    <rect x="-80" y="-80" width="160" height="160" rx="24" fill="#FFFFFF" opacity="0.12" stroke="#FFFFFF" stroke-width="2"/>
    <path d="M-50,-20 L50,-20 L50,50 L-50,50 Z" fill="#FFFFFF" opacity="0.2"/>
    <path d="M-20,-50 L20,-50 L20,50 L-20,50 Z" fill="#F5A623" opacity="0.8"/>
    <circle cx="0" cy="-20" r="14" fill="#00C2CB" opacity="0.9"/>
  </g>

  <!-- Embedded Photoshop-style artwork text -->
  
  
  <text x="400" y="408.00000000000006" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="44" font-weight="900" fill="#FFFFFF" letter-spacing="1">
    PHOTO GIFTS
  </text>
  
  
  <text x="400" y="462" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="19.2" font-weight="600" fill="#FCE4EF" letter-spacing="3">
    TRANSFORM PHOTOS INTO ART
  </text>

  <!-- Brand watermark -->
  <text x="400" y="552" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="14.399999999999999" font-weight="700" fill="#FFFFFF" opacity="0.85" letter-spacing="4">
    ✦ ARTUNIQUE • PERSONALISED LUXURY ✦
  </text>
</svg>